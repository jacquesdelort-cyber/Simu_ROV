        rov=(3.0, -10.0),
    ),
    SharedCableCase(
        name='Cas simple 3',
        x_cable=np.array([0.3, 1.9, 2.0, 2.6, 2.8, 2.8], dtype=float),
        y_cable=np.array([-0.2, -1.8, -3.9, -5.9, -7.9, -9.6], dtype=float),
        l_target=10.8,
        n_segments=10,
        n_target=10,
        boat=(0.0, 0.0),
        rov=(3.0, -10.0),
    ),
    SharedCableCase(
        name='Cas réaliste 1',
        x_cable=np.array([0.2, 1.0, 1.6, 1.8, 2.1, 2.4, 2.5, 2.7, 3.0, 3.1, 3.2], dtype=float),
        y_cable=np.array([-1.0, -1.9, -2.1, -3.3, -4.1, -5.0, -6.1, -7.1, -8.2, -9.1, -10.1], dtype=float),
        l_target=11.5,
        n_segments=5,
        n_target=5,
        boat=(0.0, 0.0),
        rov=(3.2, -9.9),
    ),
    SharedCableCase(
        name='Fallback : L_target trop court (corde bateau–ROV > cible, droite)',
        x_cable=np.array([0.0, 10.0], dtype=float),
        y_cable=np.array([0.0, -2.0], dtype=float),
        l_target=5.0,
        n_segments=6,
        n_target=6,
        boat=(0.0, 0.0),
        rov=(10.0, -2.0),
    ),
)


def get_shared_case(name: str) -> SharedCableCase:
    """Retourne un cas par nom exact (lève ``KeyError`` si inconnu)."""
    for c in ALL_SHARED_CABLE_CASES:
        if c.name == name:
            return c
    raise KeyError(name)


# Alias pratique pour les tests unitaires (même scénario que l’ancien test fallback)
CASE_FALLBACK_LT_SHORT: SharedCableCase = get_shared_case(
    "Fallback : L_target trop court (corde bateau–ROV > cible, droite)"
)


def _fmt_np_1d(arr: np.ndarray) -> str:
    vals = np.asarray(arr, dtype=float).reshape(-1).tolist()
    inner = ", ".join(repr(float(v)) for v in vals)
    return f"np.array([{inner}], dtype=float)"


def _serialize_shared_cable_case(c: SharedCableCase) -> str:
    """Émet un littéral SharedCableCase(...) pour réécriture du fichier."""
    lines = [
        "    SharedCableCase(",
        f"        name={c.name!r},",
        f"        x_cable={_fmt_np_1d(c.x_cable)},",
        f"        y_cable={_fmt_np_1d(c.y_cable)},",
        f"        l_target={float(c.l_target)!r},",
        f"        n_segments={int(c.n_segments)!r},",
        f"        n_target={int(c.n_target)!r},",
        f"        boat=({float(c.boat[0])!r}, {float(c.boat[1])!r}),",
        f"        rov=({float(c.rov[0])!r}, {float(c.rov[1])!r}),",
    ]
    if c.k_tail is not None:
        lines.append(f"        k_tail={int(c.k_tail)!r},")
    if c.k_max is not None:
        lines.append(f"        k_max={float(c.k_max)!r},")
    if c.bidirectional is not None:
        lines.append(f"        bidirectional={c.bidirectional!r},")
    if c._from_direction is not None:
        lines.append(f"        _from_direction={c._from_direction!r},")
    if c.t is not None:
        lines.append(f"        t={float(c.t)!r},")
    lines.append("    ),")
    return "\n".join(lines)


def _serialize_all_shared_cases_tuple(cases: tuple[SharedCableCase, ...]) -> str:
    return "\n".join(_serialize_shared_cable_case(c) for c in cases)


def _replace_all_shared_cable_cases_tuple_block(src: str, new_inner: str) -> str:
    m = re.search(
        r"ALL_SHARED_CABLE_CASES:\s*tuple\[SharedCableCase,\s*\.\.\.\]\s*=\s*\(",
        src,
    )
    if not m:
        raise ValueError("Bloc ALL_SHARED_CABLE_CASES introuvable dans le fichier source.")
    start_paren = m.end() - 1
    depth = 0
    end_paren = None
    for i in range(start_paren, len(src)):
        ch = src[i]
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth == 0:
                end_paren = i
                break
    if end_paren is None:
        raise ValueError("Parenthèses du tuple ALL_SHARED_CABLE_CASES non équilibrées.")
    return src[: start_paren + 1] + "\n" + new_inner.rstrip() + "\n" + src[end_paren:]


def _write_cable_shared_cases_file(
    cases: tuple[SharedCableCase, ...],
    path: Path | None = None,
) -> None:
    """Réécrit ``ALL_SHARED_CABLE_CASES`` dans ce module (écriture atomique + backup .bak)."""
    target = path if path is not None else Path(__file__).resolve()
    inner = _serialize_all_shared_cases_tuple(cases)
    text = target.read_text(encoding="utf-8")
    new_text = _replace_all_shared_cable_cases_tuple_block(text, inner)
    bak = target.with_suffix(target.suffix + ".bak")
    shutil.copy2(target, bak)
    tmp = target.with_suffix(target.suffix + ".tmp")
    tmp.write_text(new_text, encoding="utf-8")
    tmp.replace(target)


def add_cable_to_test_cases(
    x_cable,
    y_cable,
    L_target,
    x_boat=None,
    y_boat=0.0,
    x_rov=None,
    y_rov=None,
    k_tail=10,
    k_max=2.0,
    bidirectional=True,
    _from_direction=None,
    t: float | None = None,
    *,
    _path: Path | None = None,
) -> SharedCableCase:
    """
    Construit le cas « Nouveau cas » (mêmes entrées que ``CableSolver._normalize_cable_length``),
    le place en tête de ``ALL_SHARED_CABLE_CASES`` (ou remplace l’entrée existante de ce nom),
    puis persiste en réécrivant ``cable_shared_cases.py``.

    ``_path`` : cible de fichier (tests uniquement) ; par défaut ce module sur disque.
    """
    global ALL_SHARED_CABLE_CASES

    x_arr = np.asarray(x_cable, dtype=float).reshape(-1)
    y_arr = np.asarray(y_cable, dtype=float).reshape(-1)
    if x_arr.size != y_arr.size or x_arr.size < 2:
        raise ValueError("x_cable et y_cable doivent avoir la même taille >= 2.")

    x_boat_eff = x_boat if x_boat is not None else float(x_arr[0])
    y_boat_eff = y_boat if y_boat is not None else float(y_arr[0])
    x_rov_eff = x_rov if x_rov is not None else float(x_arr[-1])
    y_rov_eff = y_rov if y_rov is not None else float(y_arr[-1])

    n_seg = int(x_arr.size - 1)
    new_case = SharedCableCase(
        name="Nouveau cas",
        x_cable=x_arr.copy(),
        y_cable=y_arr.copy(),
        boat=(float(x_boat_eff), float(y_boat_eff)),
        rov=(float(x_rov_eff), float(y_rov_eff)),
        l_target=float(L_target),
        n_segments=n_seg,
        n_target=n_seg,
        k_tail=int(k_tail),
        k_max=float(k_max),
        bidirectional=bool(bidirectional),
        _from_direction=_from_direction if _from_direction is None else str(_from_direction),
        t=None if t is None else float(t),
    )

    rest = tuple(c for c in ALL_SHARED_CABLE_CASES if c.name != "Nouveau cas")
    ALL_SHARED_CABLE_CASES = (new_case,) + rest

    _write_cable_shared_cases_file(ALL_SHARED_CABLE_CASES, path=_path)

    return new_case


__all__ = [
    "ALL_SHARED_CABLE_CASES",
    "CASE_FALLBACK_LT_SHORT",
    "SharedCableCase",
    "get_shared_case",
    "add_cable_to_test_cases",
]
